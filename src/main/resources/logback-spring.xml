<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。

  要点：
  - 每行都带 traceId（由 TraceIdFilter 写入 MDC）
  - ERROR 级别单独一份文件，便于排查
  - 严禁打印凭证、完整预签名地址、儿童个人数据与业务正文（见 docs/04）
-->
<configuration>

    <property name="LOG_HOME" value="${LOG_HOME:-logs}"/>
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/early-learning-server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/early-learning-server.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/early-learning-server-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/early-learning-server-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

    <!-- 本项目代码开到 DEBUG 便于排查；第三方保持 INFO -->
    <logger name="com.earlylearning" level="DEBUG"/>

    <!-- 这几个 Mapper 的 SQL 日志会带出密码哈希、refresh 哈希、激活码哈希与幂等快照，不开 DEBUG -->
    <logger name="com.earlylearning.early_learning_server.identity.mapper.AdminAccountMapper" level="INFO"/>
    <logger name="com.earlylearning.early_learning_server.identity.mapper.TeacherAccountMapper" level="INFO"/>
    <logger name="com.earlylearning.early_learning_server.identity.mapper.LicenseMapper" level="INFO"/>
    <logger name="com.earlylearning.early_learning_server.common.idempotency.IdempotencyRecordMapper" level="INFO"/>

</configuration>
