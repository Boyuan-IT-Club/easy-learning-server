# 复制为 .env 后填写本地配置；启动前按 README.md 将其加载到环境变量。
# 格式：每行 KEY=VALUE，不加引号，不在值后追加注释；值按原文读取。
# .env 仅供本机使用，不要将真实凭证写入本示例或提交到仓库。

# 应用（可选，以下为当前默认值）
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL：先创建 early_learning 数据库，再填写可访问该库的账号密码。
# 修改主机、端口或库名时，直接修改完整 JDBC URL。
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/early_learning?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# 阿里云 OSS：以下五项为必填，Endpoint、Region 必须与 Bucket 匹配。
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BUCKET_NAME=early-learning-dev-1
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 临时下载地址有效期：单位秒，范围 1～604800，默认 900。
OSS_DOWNLOAD_URL_TTL_SECONDS=900

# OSS 客户端超时与连接池（可选，以下为默认值）。故障时快速失败，而不是把请求挂住。
# 上传大文件不受 socket 超时影响：它关心的是「多久没有数据」，不是「总共花了多久」。
OSS_CONNECTION_TIMEOUT_MS=5000
OSS_SOCKET_TIMEOUT_MS=30000
OSS_CONNECTION_REQUEST_TIMEOUT_MS=5000
OSS_MAX_CONNECTIONS=64
OSS_MAX_ERROR_RETRY=2

# 默认禁止访问真实 Bucket 的测试；联调步骤见 docs/OSS接入.md。
OSS_REAL_TEST=false

# 大模型（ECNU / ChatECNU）。文字类评分走 model-text，带图片的评分走 model-vision——
# 因为 ecnu-max 不支持图片理解，评图只能用 ecnu-plus；这条规则固化在配置里，由程序按请求是否带图自动选。
# 默认 provider=ecnu：填好 API Key 再启动，缺 Key 启动直接报错（fail-fast），不会静默降级。
# 离线跑通链路（不需要 Key）时，显式改回 provider=fake，全部走内置假实现。
# API Key 在 https://developer.ecnu.edu.cn/vitepress/llm/authorization.html 申请，只写进本机 .env。
AI_LLM_PROVIDER=ecnu
AI_LLM_ECNU_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
AI_LLM_ECNU_API_KEY=
AI_LLM_ECNU_MODEL_TEXT=ecnu-max
AI_LLM_ECNU_MODEL_VISION=ecnu-plus
# 思考模式：{"type":"enabled"}，默认关闭以控制延迟；强度留空表示不传（ecnu-max 可选 low/high/max，ecnu-plus 可选 low/medium/xhigh）。
AI_LLM_ECNU_THINKING=false
AI_LLM_ECNU_REASONING_EFFORT=
# 单次调用超时与单张图片字节上限（ECNU 文档未给图片上限，这里自定 5MB）。
AI_LLM_ECNU_TIMEOUT_SECONDS=120
AI_LLM_ECNU_MAX_IMAGE_BYTES=5242880
