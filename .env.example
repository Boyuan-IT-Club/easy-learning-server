# 复制为 .env 后填写本地配置；启动前按 README.md 将其加载到环境变量。
# 格式：每行 KEY=VALUE，不加引号，不在值后追加注释；值按原文读取。
# .env 仅供本机使用，不要将真实凭证写入本示例或提交到仓库。

# 应用（可选，以下为当前默认值）
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL：先创建 early_learning 数据库，再填写可访问该库的账号密码。
# 修改主机、端口或库名时，直接修改完整 JDBC URL。
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/early_learning?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# 阿里云 OSS：以下五项为必填，Endpoint、Region 必须与 Bucket 匹配。
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BUCKET_NAME=early-learning-dev-1
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 临时下载地址有效期：单位秒，范围 1～604800，默认 900。
OSS_DOWNLOAD_URL_TTL_SECONDS=900

# OSS 客户端超时与连接池（可选，以下为默认值）。故障时快速失败，而不是把请求挂住。
# 上传大文件不受 socket 超时影响：它关心的是「多久没有数据」，不是「总共花了多久」。
OSS_CONNECTION_TIMEOUT_MS=5000
OSS_SOCKET_TIMEOUT_MS=30000
OSS_CONNECTION_REQUEST_TIMEOUT_MS=5000
OSS_MAX_CONNECTIONS=64
OSS_MAX_ERROR_RETRY=2

# 默认禁止访问真实 Bucket 的测试；联调步骤见 docs/OSS接入.md。
OSS_REAL_TEST=false
